  "license": "MIT",
  "keywords": ["skills", "agent-skills", "SKILL.md", "catalog", "install", "mcp"],
  "mcpServers": {
    "skills-atlas": {
      "command": "npx",
      "args": ["-y", "skills-atlas@latest", "mcp"]
    }
  }
}
